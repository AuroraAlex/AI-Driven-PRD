# Copy this file to .env and fill in your API keys

# ── LLM Provider Keys ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── App settings ───────────────────────────────────────────────
DEBUG=false
DEFAULT_MODEL=openai/gpt-4o

# ── File limits ────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100

# ── CORS (comma-separated) ─────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173"]
